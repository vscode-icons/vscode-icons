// A launch configuration that launches the extension inside a new window
// Use IntelliSense to learn about possible Node.js debug attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Extension",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/src/**/*.js"],
      "preLaunchTask": "npm: build - dev"
    },
    {
      "name": "Launch Extension - without extensions",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--disable-extensions"
      ],
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/src/**/*.js"],
      "preLaunchTask": "npm: build - dev"
    },
    {
      "name": "Run Web Extension in VS Code",
      "type": "extensionHost",
      "debugWebWorkerHost": true,
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionDevelopmentKind=web"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/out/src/**/*.js",
        "${workspaceFolder}/dist/src/**/*.js"
      ],
      "preLaunchTask": "npm: dist - dev"
    },
    {
      "name": "Launch Tests",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/out/test"
      ],
      "sourceMaps": true,
      "outFiles": [
        "${workspaceFolder}/out/test/**/*.js",
        "${workspaceFolder}/out/src/**/*.js"
      ],
      "preLaunchTask": "npm: build - dev"
    },
    {
      "name": "Debug Build",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/src/tools/build.js",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: build - dev"
    },
    {
      "name": "Debug Bundle",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/src/tools/bundle.js",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: build - dev"
    },
    {
      "name": "Debug SVGO Check",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/out/src/tools/svgoCheck.js",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: build - dev"
    }
  ]
}
